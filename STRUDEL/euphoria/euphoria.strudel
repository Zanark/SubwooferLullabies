// EUPHORIA - original Eurodance-style learning loop, recovered from our chat.
// Not a transcription of "Better Off Alone".
// 128 BPM. Four-bar phrase: export cycles 0-4 for a 7.5-second preview.
// This repeats; longer exports repeat the same phrase. Allow for effect tails.

setcpm(128 / 4)

$: sound("bd*4, [~ sd]*2, hh*8")
  .bank("RolandTR909")
  .gain(0.45)

$: note("<[~ d2]*4 [~ bb1]*4 [~ f2]*4 [~ c2]*4>")
  .sound("sawtooth")
  .lpf(650)
  .attack(0.01)
  .decay(0.15)
  .sustain(0)
  .release(0.08)
  .gain(0.3)

$: note("<[d4,f4,a4] [bb3,d4,f4] [f3,a3,c4] [c4,e4,g4]>")
  .sound("triangle")
  .attack(0.08)
  .release(0.3)
  .room(0.3)
  .gain(0.15)

$: note(`<
  [d5 ~ f5 a5 ~ g5 f5 e5]
  [f5 ~ d5 f5 ~ bb5 a5 f5]
  [a5 ~ g5 f5 ~ c5 f5 a5]
  [g5 ~ e5 g5 ~ c6 g5 e5]
>`)
  .sound("sawtooth")
  .attack(0.01)
  .decay(0.12)
  .sustain(0)
  .release(0.08)
  .lpf(2400)
  .delay(0.25)
  .room(0.2)
  .gain(0.18)
