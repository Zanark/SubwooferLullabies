// YEET THAT GLOW STICK - LEVEL 5: "Near the Surface"
// Blim: roots, air, sunlight through cracks. Hope is tangible; escape is not yet.
// 32 bars at 88 BPM (87.273s). No boss beat, victory cadence, or early farewell.
// Preview export: 0-32, 48000 Hz, Multi Channel Orbits OFF. See CUE_SHEET.txt.

const scene = 'ascent'; // 'ascent' or 'after-final-journal'
const listening = false; // true for the cassette itself, not its aftermath.

setcpm(88 / 4);
if (!['ascent', 'after-final-journal'].includes(scene)) {
  throw new Error('Choose ascent or after-final-journal.');
}
if (typeof listening !== 'boolean') {
  throw new Error('listening must be true or false.');
}
const carryingTheWords = scene === 'after-final-journal';

// Familiar sewer notes find open F-major harmony, without the ending's D-major arrival.
const freshAir = note(`<
  [d5 ~ a4 ~ f5 e5 d5 ~]
  [e5 ~ g5 ~ c6 ~ g5 ~]
  [d5 e5 a5 ~ f5 ~ e5 ~]
  [f5 ~ a5 ~ d6 ~ c6 ~]
  [g5 ~ d5 ~ bb5 a5 g5 ~]
  [a5 ~ g5 f5 ~ e5 d5 ~]
  [e5 ~ g5 ~ d6 ~ c6 ~]
  [g5 ~ e5 ~ d5 ~ ~ ~]
>`);
const lookUp = note(`<
  [a5 ~ c6 ~ d6 ~ c6 ~]
  [g5 ~ e5 ~ d5 ~ ~ ~]
  [f5 ~ a5 ~ e5 d5 ~ ~]
  [d6 ~ c6 ~ a5 ~ f5 ~]
  [bb5 ~ a5 g5 ~ d5 ~ ~]
  [a5 ~ f5 ~ e5 ~ d5 ~]
  [g5 ~ c6 ~ d6 ~ e6 ~]
  [d6 ~ c6 ~ g5 ~ ~ ~]
>`);

// This response is available ONLY after Blim has heard "Whoever Finds This".
// More space, not a funeral: Blim receives encouragement and keeps climbing.
const carryTheWords = note(`<
  [a4 ~ c5 ~ d5 ~ e5 ~]
  [~ ~ g4 ~ e5 ~ ~ ~]
  [d5 ~ ~ a4 ~ f5 ~ ~]
  [f5 ~ ~ d5 ~ ~ ~ ~]
  [bb4 ~ ~ d5 ~ ~ ~ ~]
  [a4 ~ c5 ~ d5 ~ ~ ~]
  [e5 ~ ~ g5 ~ ~ ~ ~]
  [d5 ~ ~ ~ ~ ~ ~ ~]
>`);
const melody = carryingTheWords
  ? arrange([8, carryTheWords], [8, silence], [8, carryTheWords], [8, silence])
  : arrange([8, freshAir], [8, lookUp], [8, silence], [8, freshAir]);

stack(
  note(`<
    [f2 ~ ~ c3 f2 ~ ~ ~] [e2 ~ ~ g2 e2 ~ ~ ~]
    [d2 ~ ~ a2 d2 ~ ~ ~] [bb1 ~ ~ f2 bb1 ~ ~ ~]
    [g1 ~ ~ d2 g1 ~ ~ ~] [a1 ~ ~ f2 a1 ~ ~ ~]
    [c2 ~ ~ g2 c2 ~ ~ ~] [c2 ~ ~ g2 c2 ~ ~ ~]
  >`)
    .sound("triangle").lpf(1400)
    .attack(0.012).decay(0.2).sustain(0.12).release(0.12)
    .clip(0.65).gain(carryingTheWords ? 0.2 : 0.25)
    .orbit(0).room(0).delay(0),

  melody.sound("square").lpf(carryingTheWords ? 2200 : 3000).vib(4).vibmod(0.06)
    .attack(0.025).decay(0.2).sustain(0.08).release(0.2)
    .clip(0.65).gain(listening ? 0 : (carryingTheWords ? 0.07 : 0.085))
    .orbit(1).room(0.3).roomsize(2).roomfade(0.1).delay(0),

  note("<[f3,a3,e4] [e3,g3,c4] [d3,f3,c4] [bb2,f3,a3] [g2,bb2,f3] [a2,c3,f3] [c3,g3,d4] [c3,g3,e4]>")
    .sound("triangle").lpf(1800)
    .attack(0.3).decay(0.4).sustain(0.25).release(0.5)
    .clip(0.65).gain(0.045)
    .orbit(2).room(0.45).roomsize(2).roomfade(0.1).delay(0),

  note(`<
    [~ ~ a5 ~ ~ ~ ~ ~] [~ ~ ~ ~ e6 ~ ~ ~]
    [~ ~ d6 ~ ~ ~ ~ ~] [~ f6 ~ ~ ~ ~ ~ ~]
    [~ ~ ~ d6 ~ ~ ~ ~] [~ ~ ~ ~ a5 ~ ~ ~]
    [~ ~ e6 ~ ~ ~ ~ ~] [~ ~ ~ ~ g5 ~ ~ ~]
  >`)
    .sound("sine")
    .attack(0.001).decay(0.08).sustain(0).release(0.12)
    .gain(carryingTheWords ? 0.05 : 0.065).orbit(3)
    .delay(0.45).delaytime(45 / 88).delayfeedback(0.5)
    .room(0.6).roomsize(2).roomfade(0.1),

  // The human-traces timbre from Level 2 returns in the final-journal aftermath.
  note("[~ a4 ~ c5 ~ d5 e5 ~]")
    .mask("<0!16 1 0!15>")
    .sound("triangle").fm(0.8).fmh(2).lpf(2200)
    .attack(0.01).decay(0.2).sustain(0).release(0.22)
    .gain(carryingTheWords && !listening ? 0.05 : 0)
    .orbit(4).room(0.38).roomsize(2).roomfade(0.1).delay(0),

  note("[d2 ~ ~ ~ d2 ~ ~ ~]")
    .sound("sine").penv(8).pdecay(0.05).lpf(700)
    .attack(0.001).decay(0.1).sustain(0).release(0.03)
    .gain(carryingTheWords ? 0 : 0.09)
    .orbit(5).room(0).delay(0),

  sound("[~ white ~ white ~ white ~ white]")
    .hpf(2800).lpf(5000)
    .attack(0.001).decay(0.02).sustain(0).release(0.01)
    .gain(carryingTheWords || listening ? 0 : 0.015)
    .orbit(6).room(0).delay(0)
).mul(gain(listening ? 0.3 : 1)).pan(0.5);
