// YEET THAT GLOW STICK - LEVEL 2: "Someone Was Here"
// Blim: an abandoned room, a fresh wrapper, a voice on tape. Maybe not alone.
// Curiosity and small comfort, NOT mourning or knowledge of the Guide's ending.
// 32 bars at 88 BPM (87.273s). No headlamp.
// Preview export: 0-32, 48000 Hz, Multi Channel Orbits OFF. See CUE_SHEET.txt.

const listening = false; // true for a quieter, lead-free cassette preview.

setcpm(88 / 4);
if (typeof listening !== 'boolean') {
  throw new Error('listening must be true or false.');
}

const question = note(`<
  [a4 ~ c5 d5 ~ c5 a4 ~]
  [f4 ~ a4 e5 ~ d5 ~ ~]
  [f4 ~ d5 ~ c5 bb4 ~ ~]
  [g4 ~ c5 ~ d5 ~ e5 ~]
  [a4 c5 ~ d5 c5 ~ a4 ~]
  [d5 ~ e5 f5 ~ a4 ~ ~]
  [bb4 ~ d5 c5 ~ a4 g4 ~]
  [a4 ~ c#5 e5 ~ d5 e5 ~]
>`);
const followTheMarks = note(`<
  [c5 ~ a4 ~ d5 ~ c5 ~]
  [d5 ~ a4 ~ f5 e5 d5 ~]
  [bb4 ~ f4 ~ a4 ~ d5 ~]
  [c5 ~ g4 ~ e5 d5 ~ ~]
  [a4 ~ c5 ~ e5 ~ d5 ~]
  [f5 ~ e5 d5 ~ a4 ~ ~]
  [g4 ~ bb4 d5 ~ c5 bb4 ~]
  [a4 ~ e5 ~ c#5 ~ ~ ~]
>`);
const melody = arrange(
  [8, question], [8, followTheMarks], [8, silence], [8, question]
);

stack(
  note(`<
    [f2 ~ c3 ~ f2 ~ ~ c3] [d2 ~ a2 ~ d2 ~ ~ a2]
    [bb1 ~ f2 ~ bb1 ~ ~ f2] [c2 ~ g2 ~ c2 ~ ~ g2]
    [f2 ~ c3 ~ f2 ~ ~ c3] [d2 ~ a2 ~ d2 ~ ~ a2]
    [g1 ~ d2 ~ g1 ~ ~ d2] [a1 ~ e2 ~ a1 ~ ~ e2]
  >`)
    .sound("triangle").lpf(1000)
    .attack(0.008).decay(0.18).sustain(0.1).release(0.09)
    .clip(0.6).gain(0.28)
    .orbit(0).room(0).delay(0),

  melody.sound("square").lpf(1900).vib(4).vibmod(0.08)
    .attack(0.018).decay(0.16).sustain(0).release(0.16)
    .clip(0.6).gain(listening ? 0 : 0.085)
    .orbit(1).room(0.22).roomsize(2).roomfade(0.1).delay(0),

  note("<[f3,a3,e4] [d3,a3,e4] [bb2,f3,a3] [c3,g3,d4] [f3,a3,e4] [d3,f3,a3] [g2,bb2,f3] [a2,e3,g3]>")
    .sound("triangle").lpf(1200)
    .attack(0.25).decay(0.4).sustain(0.22).release(0.4)
    .clip(0.65).gain(0.04)
    .orbit(2).room(0.4).roomsize(2).roomfade(0.1).delay(0),

  note(`<
    [~ ~ a5 ~ ~ ~ ~ ~] [~ ~ ~ ~ d6 ~ ~ ~]
    [~ f6 ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ e6 ~ ~ ~]
    [~ ~ c6 ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ a5 ~ ~]
    [~ ~ d6 ~ ~ ~ ~ ~] [~ ~ ~ e6 ~ ~ ~ ~]
  >`)
    .sound("sine")
    .attack(0.001).decay(0.08).sustain(0).release(0.12)
    .gain(0.075).orbit(3)
    .delay(0.45).delaytime(45 / 88).delayfeedback(0.5)
    .room(0.6).roomsize(2).roomfade(0.1),

  // A-C-D-E: Blim's association with human traces, not an off-screen Guide scene.
  note("[~ a4 ~ c5 ~ d5 e5 ~]")
    .mask("<1 0 0 0 0 0 0 0>")
    .sound("triangle").fm(0.8).fmh(2).lpf(2200)
    .attack(0.01).decay(0.2).sustain(0).release(0.22)
    .gain(listening ? 0 : 0.05)
    .orbit(4).room(0.38).roomsize(2).roomfade(0.1).delay(0),

  note("[d2 ~ ~ ~ d2 ~ ~ ~]")
    .sound("sine").penv(10).pdecay(0.04).lpf(700)
    .attack(0.001).decay(0.09).sustain(0).release(0.03)
    .gain(0.1).orbit(5).room(0).delay(0),

  sound("[~ white ~ white ~ white ~ white]")
    .hpf(2500).lpf(4500)
    .attack(0.001).decay(0.02).sustain(0).release(0.012)
    .gain(listening ? 0 : 0.018).orbit(6).room(0).delay(0)
).mul(gain(listening ? 0.3 : 1)).pan(0.5);
