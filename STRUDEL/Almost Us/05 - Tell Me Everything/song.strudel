  [182.1,1.15,'au_cello_50',0.13087534,0.43,2934.07376,0.14,0.55],
];
const albumHaps = albumEvents.map(([t,d,s,gain,pan,lpf,attack,release]) => {
  const whole = new TimeSpan(t*albumCps,(t+d)*albumCps);
  return new Hap(whole,whole,{s,gain,pan,lpf,attack,decay:0,sustain:1,release,clip:1,orbit:1});
});
const albumPattern = new Pattern(state => albumHaps.flatMap(hap => {
  const part = hap.whole.intersection(state.span);
  return part ? [new Hap(hap.whole,part,hap.value)] : [];
}));
albumPattern
