    [~ ~ g4 bb4 ~ d5 ~ g5]
    [a4 ~ d5 ~ ~ f5 e5 ~]
    [~ f4 bb4 ~ d5 ~ c5 ~]
    [e4 ~ ~ a4 ~ c#5 ~ ~]
