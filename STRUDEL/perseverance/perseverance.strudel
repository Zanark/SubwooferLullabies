    [bd ~ bd ~ rim ~ ~ bd, hh*8]
    [bd ~ ~ rim ~ bd rim ~, hh hh ~ hh]
    [bd rim ~ bd ~ ~ rim bd, hh*4]
    [bd ~ rim ~ bd rim [bd ~] ~, hh*4]
  >`)),

  water(note(`<
    [~ d6 ~ ~ ~ a5 ~ ~]
    [~ ~ g6 ~ ~ ~ ~ ~]
    [~ ~ ~ f6 ~ ~ d6 ~]
    [~ ~ ~ ~ ~ g6 ~ ~]
    [~ d6 ~ ~ ~ ~ g6 ~]
    [~ ~ a6 ~ ~ ~ ~ ~]
    [~ ~ ~ ~ f6 ~ ~ d6]
    [~ ~ e6 ~ ~ ~ ~ ~]
  >`)),

  warmth(note(`<
    [d3,f3,a3] ~ [bb2,d3,f3] [eb3,g3,bb3]
    ~ [a2,d3,f3] ~ [a2,c#3,g3]
  >`)),

  glimmer(note(`<
    [~ a4 d5 ~ ~ f5 ~ a4]
