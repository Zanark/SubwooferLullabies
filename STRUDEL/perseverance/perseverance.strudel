    [~ ~ ~ ~ a6 ~ ~ ~]
    [~ g6 ~ ~ ~ ~ b5 ~]
    [~ ~ ~ e6 ~ ~ ~ ~]
    [~ ~ f#6 ~ ~ ~ ~ ~]
    [~ ~ ~ ~ g6 ~ ~ ~]
    [~ ~ e6 ~ ~ ~ ~ ~]
    [~ ~ ~ ~ d6 ~ ~ ~]
  >`)),

  warmth(note(`<
    [d3,f#3,a3] [b2,d3,f#3] [g2,b2,d3] [a2,c#3,e3]
    [b2,f#3,a3] [g2,b2,e3] [a2,e3,g3] [d3,f#3,a3,e4]
  >`)),

  traces(note(`<
    ~
    [~ ~ b4 ~ d5 ~ f#5 ~]
