    [~ ~ ~ ~ white ~ ~ ~]
    ~
    [~ ~ white ~ ~ white ~ ~]
    [~ ~ ~ white ~ ~ ~ ~]
    ~
  >`))
);

// 36-44 | Roots, fresh air, distant daylight. F-major warmth, not the ending yet.
const rootsAndAir = stack(
  bass(note(`<
    [f2 ~ c3 a2 ~ f3 ~ c3]
    [e2 ~ g2 c3 ~ e3 ~ g2]
    [d2 a2 ~ f3 ~ d3 a2 ~]
    [bb1 ~ f2 d3 ~ a2 ~ f2]
    [g1 d2 ~ g2 bb2 ~ d3 ~]
    [a1 ~ c3 f3 ~ e3 c3 ~]
    [c2 ~ g2 e3 ~ d3 ~ c3]
    [a1 ~ e2 g2 ~ c#3 ~ e3]
  >`)),

  lead(note(`<
    [f5 ~ a5 c6 ~ a5 g5 f5]
    [e5 g5 ~ c6 d6 ~ c6 g5]
    [f5 ~ e5 a5 d6 c6 ~ a5]
    [bb5 a5 f5 ~ d6 ~ c6 a5]
    [g5 ~ d6 bb5 a5 g5 ~ d5]
    [a5 c6 ~ f6 e6 ~ c6 a5]
    [g5 c6 d6 ~ e6 d6 c6 ~]
    [e6 ~ c#6 a5 g5 ~ e5 ~]
  >`)).gain(0.075),

  drums(sound(`<
    [bd ~ rim ~, hh*4]
    [bd ~ rim [~ bd], hh hh ~ hh]
    [bd ~ ~ rim, hh*4]
    [bd ~ rim ~, ~ hh ~ hh]
    [bd ~ rim [bd ~], hh*4]
    [bd ~ ~ rim, hh ~ hh hh]
    [bd ~ rim ~, hh hh hh ~]
