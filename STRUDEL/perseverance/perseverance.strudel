// 52-60 | The surface belongs to Blim. F becomes F#: relief, not a victory march.
// The last little drop is the nearly spent glowstick thrown back down.
const daylight = stack(
  bass(note(`<
    [d2 ~ a2 d3 ~ f#3 a2 ~]
    [b1 ~ f#2 ~ b2 ~ d3 ~]
    [g1 ~ d2 g2 ~ b2 d3 ~]
    [a1 ~ e2 a2 c#3 ~ e3 ~]
    [b1 ~ ~ f#2 ~ d3 ~ ~]
    [g1 ~ d2 ~ ~ b2 ~ ~]
    [a1 ~ e2 ~ d3 ~ ~ ~]
