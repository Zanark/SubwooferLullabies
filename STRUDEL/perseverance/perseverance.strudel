  >`)),

  warmth(note(`<
    [f3,a3,c4] [e3,g3,c4] [d3,f3,a3] [bb2,f3,a3]
    [g3,bb3,d4] [a3,c4,f4] [c3,g3,e4] [a2,e3,g3]
  >`)),

  glimmer(note(`<
    [~ c5 ~ f5 ~ a5 c6 ~]
    [g4 ~ c5 ~ e5 ~ g5 ~]
    [~ a4 d5 ~ f5 a5 ~ d6]
    [f5 ~ ~ d5 ~ a5 ~ f5]
    [~ d5 g5 ~ bb5 ~ a5 ~]
    [c5 ~ f5 a5 ~ c6 ~ e6]
    [~ g5 ~ c6 ~ e6 ~ d6]
    [~ ~ a4 ~ ~ ~ ~ ~]
  >`))
);

// 44-52 | Blim hears the final encouragement, then chooses the last ladder.
// The human-traces voice steps forward; percussion returns only with that choice.
const theLastJournal = stack(
  bass(note(`<
    [d2 ~ ~ ~ ~ ~ ~ ~]
    ~
    [bb1 ~ ~ ~ f2 ~ ~ ~]
    [g1 ~ ~ ~ d2 ~ ~ ~]
    [d2 ~ a2 ~ ~ d3 ~ ~]
    [c2 ~ g2 ~ c3 ~ e3 ~]
    [g1 ~ d2 g2 ~ bb2 d3 ~]
    [a1 e2 ~ a2 c#3 ~ e3 ~]
  >`)),

  lead(note(`<
    ~
    ~
    [~ ~ ~ ~ d5 ~ c5 a4]
    [bb4 ~ g4 ~ a4 ~ d5 ~]
    [d5 ~ f5 a5 ~ e5 d5 a4]
    [e5 ~ g5 c6 ~ g5 e5 d5]
    [g5 bb5 ~ a5 g5 d5 ~ e5]
