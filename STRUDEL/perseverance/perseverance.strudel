  >`)),

  lead(note(`<
    [d5 ~ a4 ~ f#5 e5 d5 a5]
    [f#5 a5 ~ b5 d6 ~ a5 f#5]
    [g5 ~ b5 d6 ~ a5 g5 f#5]
    [e5 a5 ~ c#6 b5 a5 e5 ~]
    [a5 ~ c#6 d6 ~ e6 d6 b5]
    [d6 a5 f#5 ~ e5 d5 ~ b4]
