    [bb1 ~ f2 bb2 ~ ~ d3 f2]
    [eb2 bb2 ~ g2 ~ eb3 bb2 ~]
    [g1 ~ d2 g2 bb2 ~ d3 ~]
    [a1 ~ d2 a2 ~ f3 d3 ~]
    [bb1 f2 ~ d3 c3 ~ bb2 a2]
    [a1 ~ e2 a2 ~ c#3 e3 ~]
  >`)),

  lead(note(`<
    [d4 ~ a4 d5 ~ f5 e5 d5]
    [c5 g4 ~ bb4 ~ c5 d5 e5]
    [f5 ~ d5 bb4 a4 ~ f4 ~]
    [g4 bb4 eb5 ~ d5 bb4 g4 ~]
    [g4 ~ bb4 d5 g5 ~ f5 d5]
    [e5 d5 ~ a4 f5 ~ e5 a4]
