    [e5 ~ a5 c#6 ~ b5 a5 ~]
    [~ f#5 ~ b5 ~ d6 ~ ~]
    [d5 ~ g5 ~ ~ b5 ~ ~]
    [~ ~ e5 ~ ~ a5 ~ ~]
    ~
  >`))
);

stack(
  once(0, 8, firstLight),
  once(8, 8, someoneWasHere),
  once(16, 8, theLongClimb),
  once(24, 4, lockerC19),
  once(28, 8, floodwater),
  once(36, 8, rootsAndAir),
  once(44, 8, theLastJournal),
  once(52, 8, daylight)
).pan(0.5);

// No new notes after cycle 60. Export through 64 so the loved echoes can settle.
