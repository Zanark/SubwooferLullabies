    [~ ~ e6 ~ ~ ~ ~ g6]
    [~ d6 ~ ~ ~ ~ ~ ~]
    [~ ~ ~ ~ f6 ~ ~ ~]
    [~ ~ g6 ~ ~ ~ d6 ~]
    [~ ~ ~ ~ ~ a6 ~ ~]
    [~ e6 ~ ~ ~ ~ ~ ~]
